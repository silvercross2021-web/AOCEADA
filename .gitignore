.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.mcp.json
*.mcp.json
.claude/
.agents/
design-references/

# Secrets / variables d'environnement — ne JAMAIS committer (clés SMTP, API, etc.)
.env
.env.*
*.env
!.env.example

# Comptes/identifiants de test réels — ne JAMAIS committer
AOCEDA/COMPTES.md

# Ancien modèle STT dioula de l'ancien assistant (Xenova/mms-1b-all, ~667 Mo) : plus utilisé depuis le 09/10/2026
# (l'assistant actuel a ses modèles dans AOCEDA/donnees_ia), jamais versionné ; le dossier peut être supprimé.
AOCEDA/dioula_models/

# Captures et instantanés des essais dans le navigateur (outil Playwright), jamais versionnés
.playwright-mcp/

# Sauvegardes locales (ex. db.sqlite3.sauvegarde avant de changer de branche : AGENTS.md, section 1)
*.sauvegarde

# Exclu: dependances npm (jamais versionnees)
node_modules/

# Bytecode Python compilé
__pycache__/
*.pyc

# JDK embarqué (téléchargé localement, ~330 Mo) — jamais versionné
AOCEDA/jdk21/

# Fichiers statiques collectés par `collectstatic` (régénérables via manage.py)
AOCEDA/staticfiles/

# Médias utilisateur (uploads runtime, pas du code source)
AOCEDA/media/

# Rapport de couverture de tests (régénérable)
AOCEDA/.coverage

# Builds mobiles et gros médias bruts — pas versionnés dans le dépôt de code
AOCEDA/*.apk
AOCEDA/*.mp4

# Fichiers de mémoire académique personnel (hors périmètre du dépôt de code)
AOCEDA/Memoire_IIT_BROU_KABLAN/
AOCEDA/Memoire_MD/
AOCEDA/diagrame+memoire/

# Fichiers de travail temporaires
AOCEDA/scratch/

# Logs de session (device-monitor, runserver)
logs/


# Environnement virtuel Python
venv/
.venv/
# Assistant IA : modèles (~2,1 Go, installés par « manage.py installer_modeles_ia ») et données écrites en marchant
# (conversations, voix, journaux) — jamais versionnés
AOCEDA/donnees_ia/
AOCEDA/.venv_local/
.pytest_cache/
