# Clés et réglages d'AOCEDA (modèle SANS valeurs : copier en .env puis remplir), lus par aoceda/settings.py au démarrage.
# Publiable : aucune valeur secrète ici. Le vrai .env, lui, ne doit jamais être publié.
# Modèle sans valeurs, publiable : .env.example. Les clés de l'assistant IA portent les mêmes noms que
# D:\AOCEDA_CHATBOT\.env : explications et liens pour obtenir chaque clé dans D:\AOCEDA_CHATBOT\CLES_API.txt.
# Si une clé change : la changer ici ET dans D:\AOCEDA_CHATBOT\.env + CLES_API.txt.

# ── DJANGO ─────────────────────────────────────────────────────────────────────────────────────────────
# SECRET_KEY : clé de signature (sessions, jetons de connexion JWT) ; la changer déconnecte tout le monde
SECRET_KEY=
DEBUG=True

# ── BASE DE DONNÉES ────────────────────────────────────────────────────────────────────────────────────
# sqlite3    = AOCEDA\db.sqlite3 (données ESP32 les plus récentes : 30/09/2026)
# postgresql = base PostgreSQL 16 de ce PC (dernières mesures : 29/08/2026) : décommenter et remplir DB_*
DB_ENGINE=sqlite3
# DB_NAME=aoceda
# DB_USER=aoceda
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── E-MAILS (alertes, mot de passe oublié) ─────────────────────────────────────────────────────────────
# Vide = les e-mails s'affichent dans la console du serveur. Gmail : créer un « mot de passe
# d'application » sur https://myaccount.google.com/apppasswords (l'ancien est public sur GitHub : le révoquer)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AOCEDA <no-reply@aoceda.ci>
# adresse de la page dans les liens envoyés par e-mail (lancer_aoceda.bat : port 8003)
FRONTEND_URL=http://127.0.0.1:8003

# ── PONT SÉRIE ARDUINO (serial_bridge.py) ──────────────────────────────────────────────────────────────
# Plus utilisé : l'ESP32 envoie en Wi-Fi avec sa propre clé d'appareil. Vide = route du pont fermée.
ARDUINO_BRIDGE_TOKEN=

# ══ ASSISTANT IA (chatbot AOCEDA) ══════════════════════════════════════════════════════════════════════
# AI_PROVIDER : cerveau du chat (deepseek) ; AI_DAILY_LIMIT : questions par jour et par client (0 = illimité)
AI_PROVIDER=deepseek
AI_DAILY_LIMIT=0

# ── DEEPSEEK : le cerveau du chat écrit et vocal ── https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ── GEMINI : l'appel Live et ses comptes de réserve (compte 1 essayé en premier) ── https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=

# ── CEREBRIUM : la voix baoulé sur carte graphique (GPU) ── https://dashboard.cerebrium.ai
CEREBRIUM_PROJECT=
CEREBRIUM_API_KEY=
# facultatif : jeton de gestion pour lire le crédit restant
CEREBRIUM_SERVICE_ACCOUNT_TOKEN=

# ── HUGGING FACE : téléchargement des modèles ── https://huggingface.co/settings/tokens
HF_TOKEN=

# ── OPENROUTER : modèle de secours de l'agent Live (clé plafonnée) ── https://openrouter.ai/settings/keys
OPENROUTER_KEY_AGENT=

# ── NIUTRANS : 2e traducteur du baoulé (FACULTATIF, pas encore de clé) ── https://niutrans.com
NIUTRANS_API_KEY=

# ── MODÈLES LOCAUX ET DONNÉES DE L'ASSISTANT ───────────────────────────────────────────────────────────
# ~6 Go de modèles : ils restent sur D: (C: n'a pas la place). NE PAS supprimer ces dossiers de D:.
CHATBOT_MODELES_DIR=D:\AOCEDA_CHATBOT\modeles
CHATBOT_HF_HOME=D:\AOCEDA_CHATBOT\cache\hf
CHATBOT_KOKORO_DIR=D:\AOCEDA_CHATBOT\cache\kokoro
# données écrites par l'assistant : voix déjà faites, journaux, réserves Live, banque baoulé en attente
CHATBOT_DONNEES_DIR=D:\AOCEDA_IA
# Python qui a OmniVoice (voix baoulé sur ce PC, secours du GPU)
CHATBOT_PYTHON_OMNIVOICE=D:\AOCEDA_IA_LAB\env_omnivoice\Scripts\python.exe

# ── RÉGLAGES FACULTATIFS (valeur par défaut si la ligne reste en commentaire) ─────────────────────────
# modèle d'écoute Whisper : small (précis, ~4 s) ou base (rapide, ~1,5 s)
# CHATBOT_WHISPER=small
# autre liste de modèles Live, séparés par des virgules (vide = liste par défaut, meilleur d'abord)
# CHATBOT_MODELES_LIVE=
# plafond de minutes de GPU Cerebrium par jour (0 = pas de GPU)
# CHATBOT_GPU_MINUTES_JOUR=120
# False = voix baoulé jamais sur le GPU / jamais du tout / sans la chaîne robuste
# CHATBOT_VOIX_BAOULE_GPU=True
# CHATBOT_VOIX_BAOULE=True
# CHATBOT_BAOULE_CHAINE=True
# mémoire des oreilles dioula / baoulé : retrecir (73 Mo gardés) ou garder
# CHATBOT_ONNX_RESERVE=retrecir
# port de l'atelier de voix baoulé sur ce PC
# CHATBOT_PORT_OMNIVOICE=8771
